# ═══════════════════════════════════════════════
# 报销智能化系统 — 环境变量配置
# 复制此文件为 .env 并填写真实值
# ═══════════════════════════════════════════════

# ── Flask 安全配置 ──
# [必须] Flask Session 签名密钥，生产环境务必设置为随机长字符串
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=请替换为随机生成的64位十六进制密钥
# [可选] 调试模式（生产环境必须为 0 或不设置）
# FLASK_DEBUG=0

# ── DeepSeek API 配置 ──
DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions   # API 地址
# DEEPSEEK_MODEL=deepseek-v4-flash                               # 文本链路模型（OCR 结构化/异常/分类/行程校验）

# ── 本地 OCR 引擎（方案 A，默认 Tesseract）──
# 图片/扫描件先由本地 OCR 引擎抽文本，再走「文本 → DeepSeek Function Call」管线，
# 不再依赖 DeepSeek 原生多模态能力。本地 OCR 不可用时，发票/行程单图片与扫描件 PDF
# 会自动降级为 DeepSeek Vision 兜底识别。
# LOCAL_OCR_ENGINE=tesseract                                     # 默认 tesseract（生产引擎）；可选 paddle / auto（auto 当前因未装 Paddle 实际回退 Tesseract）
# TESSERACT_LANG=chi_sim+chi_tra+eng                             # Tesseract 识别语言（需安装 chi_sim/chi_tra 语言包；覆盖简/繁体发票）
# TESSERACT_CMD=                                                 # tesseract 可执行文件路径（留空用系统 PATH；本机示例 /opt/miniconda3/bin/tesseract）
# OCR_RENDER_DPI=200                                             # 扫描件 PDF 渲染分辨率
# OCR_VISION_MAX_SIDE=1600                                       # Vision 兜底前图片最长边压缩上限(px)，防止请求体过大
# OCR_VISION_FALLBACK_ENABLED=false                              # Vision 兜底开关：默认 false（链路只走「本地 OCR + 文本 Function Call」）；
                                                                  # 设为 true/1/yes/on 可恢复「本地 OCR 失败 → DeepSeek Vision 看图」安全网（需视觉模型支持多模态）

# ── 数据库配置 ──
# OA_DB_PATH=oa_agent.db                                         # SQLite 数据库路径（默认项目根目录）

# ── 流水线实时进度（SSE）──
# OA_PROGRESS_TIMEOUT=300                                        # 单条进度长连接最长保持秒数（应大于最慢一次 AI 校验耗时）
                                                                 # 注意：进度总线为进程内内存实现，仅适用于单进程/单 worker 部署；
                                                                 # 多 worker 需改为 Redis Pub/Sub（见 web/progress_bus.py 说明）

# ── OA集成（预留）──
# OA_BASE_URL=https://oa.example.com                             # 泛微 OA API 地址
# OA_TOKEN=your_oa_token_here                                    # OA API Token

# ── 业务参数 ──
# REQUEST_TIMEOUT=120                                            # API 请求超时时间（秒）
# LOG_LEVEL=INFO                                                 # 日志级别
